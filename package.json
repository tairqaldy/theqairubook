{
  "name": "theqairubook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "setup": "npm run db:up && timeout /t 3 /nobreak >nul && npm run db:push && npm run db:seed"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.39.3",
    "hono": "^4.7.4",
    "postgres": "^3.4.5",
    "tsx": "^4.19.3"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "drizzle-kit": "^0.30.5",
    "typescript": "^5.8.2"
  }
}
